<Window x:Class="PiSignage.Control.DeviceSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Device setup" Width="500" SizeToContent="Height"
        Background="{StaticResource Bg}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <!-- Buttons have no Click handlers here: MainWindow owns all the device state,
         so it wires its existing handlers onto these buttons when opening the dialog. -->
    <StackPanel Margin="16">
        <TextBlock Text="Find and manage" FontWeight="SemiBold"/>
        <WrapPanel Margin="0,6,0,12">
            <Button x:Name="BtnScan" Content="_Find my Pi" Margin="0,0,6,4"
                    ToolTip="Search your WiFi network for Pis and add them to the list"/>
            <Button x:Name="BtnRename" Content="_Rename" Margin="0,0,6,4" IsEnabled="False"
                    ToolTip="Give the selected Pi a friendlier name"
                    ToolTipService.ShowOnDisabled="True"/>
            <Button x:Name="BtnForget" Content="Re_move" Margin="0,0,6,4" IsEnabled="False"
                    ToolTip="Take the selected Pi out of your device list (pick a saved Pi first)"
                    ToolTipService.ShowOnDisabled="True"/>
        </WrapPanel>

        <TextBlock Text="New device" FontWeight="SemiBold"/>
        <WrapPanel Margin="0,6,0,12">
            <Button x:Name="BtnSetupNew" Content="Set up a _new Pi" Margin="0,0,6,4"
                    ToolTip="Connect a brand-new Pi to your WiFi using a USB cable"/>
        </WrapPanel>

        <TextBlock Text="Maintenance" FontWeight="SemiBold"/>
        <WrapPanel Margin="0,6,0,0">
            <Button x:Name="BtnUpdatePi" Content="Update _Pi software" Margin="0,0,6,4"
                    Visibility="Collapsed"
                    ToolTip="This app came with newer Pi software — click to update your Pis. The TV will blink once."/>
            <Button x:Name="BtnPrepareDelivery" Content="Prepare Pi for delivery" Margin="0,0,6,4"
                    IsEnabled="False"
                    ToolTip="Permanently erase builder access and customer data before handing over this Pi"
                    ToolTipService.ShowOnDisabled="True"/>
        </WrapPanel>

        <!-- Pi updates run themselves overnight with nobody watching, so this is
             the only place the result is ever reported. -->
        <TextBlock x:Name="LblLastAutoUpdate" Margin="0,4,0,0" TextWrapping="Wrap"
                   FontSize="11" Foreground="{StaticResource TextMuted}"
                   Visibility="Collapsed"/>

        <Button Content="Close" IsCancel="True" HorizontalAlignment="Right"
                MinWidth="70" Margin="0,14,0,0"/>
    </StackPanel>
</Window>
