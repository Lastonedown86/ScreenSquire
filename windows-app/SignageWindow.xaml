<Window x:Class="PiSignage.Control.SignageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tournament Signage" Height="820" Width="720"
        MinHeight="560" MinWidth="480">
    <DockPanel Margin="14" LastChildFill="True">
        <ProgressBar x:Name="Busy" DockPanel.Dock="Top" Height="4" IsIndeterminate="True"
                     Visibility="Collapsed" Margin="0,0,0,8"/>
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="Target Pi"/>
            <ComboBox x:Name="CmbAgent" IsEditable="True" DisplayMemberPath="Name"
                      IsTextSearchEnabled="False" Text="localhost:8080" Margin="0,2,0,10"/>

            <TextBlock Text="Capture slot"/>
            <ComboBox x:Name="CmbSlot" SelectedIndex="0" Margin="0,2,0,10" SelectionChanged="Slot_Changed">
                <ComboBoxItem>pairings</ComboBoxItem>
                <ComboBoxItem>standings</ComboBoxItem>
            </ComboBox>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Capture region…" Click="Capture_Click" Padding="10,4"/>
                <Button x:Name="BtnRecapture" Content="Re-capture" Click="Recapture_Click"
                        Padding="10,4" Margin="8,0,0,0" IsEnabled="False"/>
            </StackPanel>

            <TextBlock Text="Round timer"/>
            <StackPanel Orientation="Horizontal" Margin="0,2,0,0" VerticalAlignment="Center">
                <TextBlock Text="Min" VerticalAlignment="Center" Margin="0,0,4,0" Foreground="#666"/>
                <TextBox x:Name="TxtMinutes" Text="25" Width="46" VerticalAlignment="Center"
                         PreviewTextInput="NumberOnly_PreviewTextInput"/>
                <TextBlock Text="Round" VerticalAlignment="Center" Margin="10,0,4,0" Foreground="#666"/>
                <TextBox x:Name="TxtRound" Text="1" Width="46" VerticalAlignment="Center"
                         PreviewTextInput="NumberOnly_PreviewTextInput"/>
                <Button Content="Start" Click="StartTimer_Click" Margin="10,0,0,0" Padding="8,2"/>
                <Button Content="Stop" Click="StopTimer_Click" Margin="6,0,0,0" Padding="8,2"/>
                <TextBlock x:Name="ClockDisplay" Text="—:—" FontSize="30" FontWeight="Bold"
                           FontFamily="Consolas" Margin="16,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="Status" Margin="0,12,0,0" Foreground="#666" TextWrapping="Wrap"/>

            <TextBlock Text="Last capture (what's on the TV)" Margin="0,12,0,4" Foreground="#666"/>
        </StackPanel>

        <!-- preview fills all remaining window space, so a bigger/resized window = bigger preview -->
        <Border BorderBrush="#DDD" BorderThickness="1" Background="#111">
            <Grid>
                <TextBlock x:Name="PreviewEmpty" Text="No capture yet" Foreground="#777"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Image x:Name="Preview" Stretch="Uniform" Margin="6"/>
                <ProgressBar x:Name="PreviewBusy" IsIndeterminate="True" Width="140" Height="6"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Visibility="Collapsed"/>
            </Grid>
        </Border>
    </DockPanel>
</Window>
