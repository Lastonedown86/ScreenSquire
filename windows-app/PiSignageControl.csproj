<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PiSignageControl</AssemblyName>
    <RootNamespace>PiSignage.Control</RootNamespace>
    <!-- allows building from CI/Linux too -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\signage-core\signage-core.csproj" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\agent\main.py" LogicalName="agent/main.py" />
    <EmbeddedResource Include="..\agent\static\**\*" LogicalName="agent/static/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
