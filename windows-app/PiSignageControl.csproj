<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>PiSignageControl</AssemblyName>
    <RootNamespace>PiSignage.Control</RootNamespace>
    <!-- allows building from CI/Linux too -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- CalVer YYYY.MM.DD.N, same scheme as agent/main.py's AGENT_VERSION.
         0.0.0 is deliberate: release.yml overrides it with -p:Version from the
         tag, so anything still reporting 0.0.0 is a local build and the
         self-updater refuses to touch it. -->
    <Version>0.0.0</Version>
    <DebugType>embedded</DebugType>
    <!-- PublishSingleFile leaves native libraries beside the exe unless this is
         set, and WPF brings five of them (wpfgfx_cor3, PresentationNative_cor3,
         D3DCompiler_47_cor3, PenImc_cor3, vcruntime140_cor3). release.yml ships
         the exe alone, so without this the downloaded copy dies on startup with
         DllNotFoundException. It only ever worked when run from its own publish
         directory, which is exactly where it was tested. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\signage-core\signage-core.csproj" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.10" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\agent\*.py" LogicalName="agent/%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\agent\static\**\*" LogicalName="agent/static/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <!-- Update (not Include): the SDK default glob already owns this file as a None
         item; a second Include would duplicate it and the copy metadata gets lost.
         TargetPath drops the tools\ folder — the app looks for the viewer next to
         the exe (RemoteViewerLauncher.BundledViewerPath).
         CopyToPublishDirectory is stated explicitly rather than left to default
         from CopyToOutputDirectory: publish is what release.yml ships, and the
         shipped app is two files side by side, not one exe. -->
    <!-- ExcludeFromSingleFile: IncludeNativeLibrariesForSelfExtract otherwise
         pulls this into the bundle, and RemoteViewerLauncher resolves the viewer
         from AppContext.BaseDirectory, i.e. beside the exe. Bundled, it is not
         there and Remote control breaks. -->
    <None Update="tools\vncviewer.exe" CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" TargetPath="vncviewer.exe"
          ExcludeFromSingleFile="true" />
  </ItemGroup>

</Project>
