<Window x:Class="PiSignage.Control.SpotifyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PiSignage.Control"
        Title="Spotify" Height="560" Width="700"
        MinHeight="400" MinWidth="520"
        Background="{StaticResource Bg}">
    <Grid>
    <DockPanel LastChildFill="True" Margin="14,10,14,10">

        <!-- which TV plays it -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <TextBlock Text="Play on:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
            <ComboBox x:Name="CmbDevice" MinWidth="220" VerticalContentAlignment="Center"
                      SelectionChanged="Device_Changed" DisplayMemberPath="Name"
                      ToolTip="The TV this window plays music on"/>
            <TextBlock x:Name="LblAgentHint" Foreground="{StaticResource Warning}" Margin="10,0,0,0"
                       VerticalAlignment="Center" TextWrapping="Wrap"/>
        </DockPanel>

        <!-- transport controls + status + login hint -->
        <StackPanel DockPanel.Dock="Bottom">
            <WrapPanel Margin="0,8,0,0" VerticalAlignment="Center">
                <Button x:Name="BtnPlay" Content="▶ _Play on TV" Style="{StaticResource PrimaryButton}"
                        Margin="0,0,14,4" Click="Play_Click"
                        ToolTip="Play the selected item on the TV"/>
                <Button x:Name="BtnPause" Content="⏸ Pause" Margin="0,0,6,4" Click="Pause_Click"
                        ToolTip="Pause or resume playback on the TV"
                        ToolTipService.ShowOnDisabled="True"/>
                <Button x:Name="BtnBack10" Content="≪ 10 s" Margin="0,0,6,4" Click="Back10_Click"
                        ToolTip="Jump back ten seconds" ToolTipService.ShowOnDisabled="True"/>
                <Button x:Name="BtnFwd10" Content="10 s ≫" Margin="0,0,14,4" Click="Fwd10_Click"
                        ToolTip="Jump ahead ten seconds" ToolTipService.ShowOnDisabled="True"/>
                <Button x:Name="BtnStop" Content="■ _Back to playlist" Margin="0,0,6,4" Click="Stop_Click"
                        ToolTip="Stop the music and let the TV go back to its normal rotation"
                        ToolTipService.ShowOnDisabled="True"/>
            </WrapPanel>
            <TextBlock x:Name="LblStatus" Foreground="{StaticResource TextMuted}" Margin="0,4,0,0"/>
            <WrapPanel Margin="0,4,0,0">
                <TextBlock Text="Tracks play 30-second previews unless Spotify is signed in on the TV."
                           Foreground="{StaticResource TextMuted}" FontSize="11"
                           VerticalAlignment="Center" TextWrapping="Wrap"/>
                <Button x:Name="BtnSignin" Content="Sign _in on TV…" Style="{StaticResource SmallButton}"
                        Margin="8,0,0,0" Click="Signin_Click"
                        ToolTip="Opens the Spotify page on the TV and a viewer window — sign in there once, then close the viewer"
                        ToolTipService.ShowOnDisabled="True"/>
            </WrapPanel>
        </StackPanel>

        <!-- saved links -->
        <GroupBox Header="Saved music and podcasts">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0,0,0,4">
                    <Button Content="+ _Add link…" DockPanel.Dock="Left" Click="Add_Click"
                            ToolTip="Paste a Spotify link — track, album, playlist, podcast, show or artist"/>
                    <TextBlock Text="Want a sequence? Save a Spotify playlist or album — it plays through by itself."
                               Foreground="{StaticResource TextMuted}" FontSize="11"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                </DockPanel>
                <ListBox x:Name="LstBookmarks" Grid.Row="1" SelectionMode="Single"
                         MouseDoubleClick="LstBookmarks_DoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="2">
                                <Grid DockPanel.Dock="Left" Width="48" Height="32" Margin="0,0,8,0">
                                    <TextBlock Text="♪" FontSize="18" Foreground="{StaticResource TextMuted}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Thumb}" Value="{x:Null}">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <Image Source="{Binding Thumb}" Stretch="Uniform"/>
                                </Grid>
                                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource SmallButton}"
                                        Click="Remove_Click" VerticalAlignment="Center" Margin="4,0,0,0"
                                        ToolTip="Remove this item from the list"/>
                                <Button DockPanel.Dock="Right" Content="▼" Style="{StaticResource SmallButton}"
                                        Click="MoveDown_Click" VerticalAlignment="Center" Margin="4,0,0,0"
                                        ToolTip="Move down"/>
                                <Button DockPanel.Dock="Right" Content="▲" Style="{StaticResource SmallButton}"
                                        Click="MoveUp_Click" VerticalAlignment="Center" Margin="8,0,0,0"
                                        ToolTip="Move up"/>
                                <TextBlock DockPanel.Dock="Right" Text="▶ playing" VerticalAlignment="Center"
                                           Foreground="{StaticResource Success}" Margin="8,0,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Display}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Kind}" FontSize="11"
                                               Foreground="{StaticResource TextMuted}"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Grid.Row="1" Text="Nothing saved yet.&#10;Click '+ Add link…' and paste a Spotify link."
                           Foreground="{StaticResource TextMuted}" TextAlignment="Center" TextWrapping="Wrap"
                           HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count, ElementName=LstBookmarks}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </GroupBox>
    </DockPanel>
    <local:Toast x:Name="Toaster" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,16,12"/>
    </Grid>
</Window>
