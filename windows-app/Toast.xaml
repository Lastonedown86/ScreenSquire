<UserControl x:Class="PiSignage.Control.Toast"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False">
    <Border x:Name="Chip" CornerRadius="4" Padding="12,8" MaxWidth="420"
            Visibility="Collapsed" Background="{StaticResource StatusBarBg}">
        <Border.Effect>
            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
        </Border.Effect>
        <TextBlock x:Name="Msg" Foreground="White" TextWrapping="Wrap"/>
    </Border>
</UserControl>
