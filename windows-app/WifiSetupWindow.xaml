<Window x:Class="PiSignage.Control.WifiSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Set up a new Pi" Width="500" SizeToContent="Height"
        Background="{StaticResource Bg}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <StackPanel Margin="16">
        <TextBlock x:Name="Step1Head" Text="1. Plug the Pi into this PC with a USB-C data cable."
                   TextWrapping="Wrap" FontWeight="SemiBold"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,12">
            <ProgressBar x:Name="Detecting" Width="120" Height="6" IsIndeterminate="True"/>
            <TextBlock x:Name="DetectStatus" Text="Looking for the Pi over USB…"
                       Margin="10,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"
                       MaxWidth="240"/>
            <Button x:Name="BtnCancelDetect" Content="Cancel" Margin="10,0,0,0"
                    Padding="8,2" Click="CancelDetect_Click"/>
            <Button x:Name="BtnRetry" Content="Retry" Visibility="Collapsed" Margin="10,0,0,0"
                    Padding="8,2" Click="Retry_Click"/>
        </StackPanel>

        <Grid x:Name="Form" IsEnabled="False">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="Step2Head" Grid.Row="0" Text="2. Choose your WiFi network" FontWeight="SemiBold" Margin="0,0,0,6"/>
            <DockPanel Grid.Row="1" Margin="0,0,0,6">
                <TextBlock Text="8-digit PIN" Width="120" VerticalAlignment="Center"/>
                <PasswordBox x:Name="TxtRecoveryPin" MaxLength="8"
                             PasswordChanged="Field_Changed"
                             ToolTip="Printed on the bottom of the Pi"/>
            </DockPanel>
            <DockPanel Grid.Row="2" Margin="0,0,0,6">
                <TextBlock Text="Network name" Width="120" VerticalAlignment="Center"/>
                <!-- pre-filled from nearby networks; typing still works if the list is empty -->
                <ComboBox x:Name="CmbSsid" IsEditable="True" IsTextSearchEnabled="False"
                          ToolTip="Pick your WiFi network — the same one this computer uses"/>
            </DockPanel>
            <DockPanel Grid.Row="3" Margin="0,0,0,10">
                <TextBlock Text="Password" Width="120" VerticalAlignment="Center"/>
                <CheckBox x:Name="ChkShow" Content="Show" DockPanel.Dock="Right" VerticalAlignment="Center"
                          Margin="8,0,0,0" Checked="ChkShow_Changed" Unchecked="ChkShow_Changed"/>
                <Grid>
                    <PasswordBox x:Name="TxtPass" PasswordChanged="Field_Changed"/>
                    <TextBox x:Name="TxtPassPlain" Visibility="Collapsed" TextChanged="Field_Changed"/>
                </Grid>
            </DockPanel>
            <Button Grid.Row="4" x:Name="BtnConnect" Content="Connect to WiFi" Style="{StaticResource PrimaryButton}"
                    Click="Connect_Click" IsEnabled="False" HorizontalAlignment="Left"/>
        </Grid>

        <TextBlock x:Name="Step3Head" Text="3. Done" FontWeight="SemiBold" Margin="0,12,0,0"
                   Foreground="{StaticResource TextMuted}"/>
        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
            <ProgressBar x:Name="Working" Width="120" Height="6" IsIndeterminate="True" Visibility="Collapsed"/>
            <TextBlock x:Name="Result" Margin="0,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                       MaxWidth="440" Text="Once the Pi is on your WiFi it appears in your device list automatically."
                       Foreground="{StaticResource TextMuted}"/>
        </StackPanel>
    </StackPanel>
</Window>
